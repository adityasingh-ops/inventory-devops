{
  "title": "Inventory App",
  "uid": "inventory-app",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second (by route)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (route)", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries",
      "title": "p95 latency (seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "type": "timeseries",
      "title": "5xx errors per second",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "errors" }]
    },
    {
      "type": "timeseries",
      "title": "Backend CPU (cores)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(process_cpu_seconds_total{job=\"backend\"}[1m])) by (pod)", "legendFormat": "{{pod}}" }]
    }
  ]
}
